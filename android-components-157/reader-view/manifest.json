{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "reader-view@veld"
    }
  },
  "name": "Veld Reader View",
  "version": "1.5",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "readability/readability-readerable-0.4.2.js",
        "readerview-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["readerview-background.js"],
    "persistent": false
  },
  "permissions": [
    "mozillaAddons",
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "storage",
    "tabs",
    "<all_urls>"
  ]
}
