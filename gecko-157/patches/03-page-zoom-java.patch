   /**
+   * Applies full-page layout zoom to this session, independently of compositor pinch zoom.
+   *
+   * @param zoom factor from {@link #PAGE_ZOOM_MIN} through {@link #PAGE_ZOOM_MAX}; 1.0 is 100%.
+   * @return the factor read back from Gecko after the update.
+   * @throws IllegalArgumentException if the factor is not finite or is outside the supported range.
+   */
+  @HandlerThread
+  public @NonNull GeckoResult<Float> setPageZoom(final float zoom) {
+    ThreadUtils.assertOnHandlerThread();
+    if (!Float.isFinite(zoom) || zoom < PAGE_ZOOM_MIN || zoom > PAGE_ZOOM_MAX) {
+      throw new IllegalArgumentException("Page zoom must be finite and between 0.30 and 5.00");
+    }
+
+    final GeckoBundle data = new GeckoBundle(1);
+    data.putString("zoom", Float.toString(zoom));
+    return mEventDispatcher
+        .queryString("GeckoView:SetPageZoom", data)
+        .map(Float::valueOf);
+  }
+
+  /**
+   * Returns this session's full-page layout zoom factor, where 1.0 is 100%.
+   *
+   * @return the factor currently reported by Gecko.
+   */
+  @HandlerThread
+  public @NonNull GeckoResult<Float> getPageZoom() {
+    ThreadUtils.assertOnHandlerThread();
+    return mEventDispatcher.queryString("GeckoView:GetPageZoom").map(Float::valueOf);
+  }
